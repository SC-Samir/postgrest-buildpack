#!/usr/bin/env bash
set -o errexit -o nounset -o pipefail

BUILD_DIR="$1"
CACHE_DIR="$2"
ENV_DIR="${3:-}"

POSTGREST_VERSION="${POSTGREST_VERSION:-14.9}"
POSTGREST_URL="https://github.com/PostgREST/postgrest/releases/download/v${POSTGREST_VERSION}/postgrest-v${POSTGREST_VERSION}-linux-static-x86-64.tar.xz"

echo "-----> Installing PostgREST v${POSTGREST_VERSION}"
echo "       ${POSTGREST_URL}"

mkdir --parents "${BUILD_DIR}/bin"

TMP_ARCHIVE="$(mktemp)"
if ! curl --fail --show-error --location "${POSTGREST_URL}" --output "${TMP_ARCHIVE}"; then
  echo "!! Failed to download PostgREST archive (check version / asset name)"
  exit 1
fi

tar --extract --xz --directory "${BUILD_DIR}/bin" --file "${TMP_ARCHIVE}"
rm --force "${TMP_ARCHIVE}"

chmod +x "${BUILD_DIR}/bin/postgrest"

echo "-----> PostgREST installed at ${BUILD_DIR}/bin/postgrest"
